# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# VIN decoder via external API (requires an API key from a VIN decoding provider, e.g. VinCheck.info / DecodeThis).
# When set, VIN make/year are decoded through the API instead of the built-in WMI/year tables.
# The built-in tables remain as a fallback if the API call fails or the key is not set.
VIN_DECODE_API_KEY=your_vin_decode_api_key_here
# VIN_DECODE_API_BASE_URL=https://api.example.com/v1/vin

# NHTSA vPIC is used as the primary free VIN decoder (no API key required).
# auto.dev is used as fallback when NHTSA does not return a model.
# Get your key at https://auto.dev
AUTODEV_API_KEY=your_autodev_api_key_here

# Server port (optional, default 3000)
# PORT=3000
